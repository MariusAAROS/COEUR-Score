# =============================================================================
# Environment variables for the OPTIONAL LLM-based generation experiments
# (experiments/llm_based/icl.ipynb, icl2.ipynb, icl3.ipynb, sft.ipynb).
#
# The core COEUR demo (example/coeur_demo.ipynb) and the noise-based
# experiments DO NOT need any of these — they run fully offline.
#
# Usage:  cp .env.example .env   then edit the values.
# =============================================================================

# --- Azure OpenAI (used by icl.ipynb via langchain_openai.AzureChatOpenAI) ---
# AzureChatOpenAI reads these automatically; the notebook hard-codes the
# deployment name ("gpt-4.1") and api_version ("2025-01-01-preview").
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/

# --- Ollama (used by icl2.ipynb / icl3.ipynb via langchain_ollama.ChatOllama)
# Point this at a reachable Ollama server. If Ollama runs on the Docker host,
# use http://host.docker.internal:11434 (Windows/macOS) or the host IP (Linux).
OLLAMA_HOST=http://host.docker.internal:11434

# --- Hugging Face (only needed to (down)load gated models for sft.ipynb) -----
# HF_TOKEN=
